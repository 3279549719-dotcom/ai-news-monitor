{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cd /e/claude/ai-news-monitor && node scripts/harness-check.js 2>&1 | tail -40",
            "async": true
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd /e/claude/ai-news-monitor && node scripts/harness-usage.js"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd /e/claude/ai-news-monitor && node scripts/harness-pretooluse.js"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd /e/claude/ai-news-monitor && node scripts/harness-stop.js"
          }
        ]
      }
    ]
  }
}
