{
  "version": "1",
  "commands": {
    "restart-pipeline": {
      "description": "触发云端 GitHub Actions 管线 daily-pipeline.yml（替代本机 run-pipeline，云端自起 crawl4ai 容器）",
      "command": "gh workflow run daily-pipeline.yml --repo 3279549719-dotcom/ai-news-monitor --ref master",
      "timeoutMs": 60000,
      "maxRetries": 1,
      "reversible": false
    },
    "npm-install": {
      "description": "重装本机 ops 脚本依赖（ops-check/auto-heal 等仍在本机运行的巡检与自愈脚本）",
      "command": "npm ci",
      "timeoutMs": 120000,
      "maxRetries": 1,
      "reversible": true
    },
    "git-pull": {
      "description": "同步远端仓库提交（代码/workflow 变更 + 云端回写的 .last-run.json 状态）",
      "command": "git pull origin master",
      "timeoutMs": 60000,
      "maxRetries": 1,
      "reversible": true
    },
    "vercel-redeploy": {
      "description": "重新部署 Vercel 最新失败部署（带 1 小时冷却防循环）",
      "command": "node scripts/vercel-check.js --redeploy",
      "timeoutMs": 60000,
      "maxRetries": 0,
      "reversible": true
    },
    "supabase-restore": {
      "description": "恢复被暂停的 Supabase 项目",
      "command": "node scripts/supabase-check.js --restore",
      "timeoutMs": 60000,
      "maxRetries": 0,
      "reversible": false
    }
  },
  "globalLimits": {
    "maxFixesPerDay": 3,
    "cooldownMinutes": 30
  }
}
